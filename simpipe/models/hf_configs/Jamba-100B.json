  "hidden_size": 8192,
  "intermediate_size": 24576,
  "moe_ffn_hidden_size": 3456,
  "num_experts": 16,
  "moe_router_topk": 2,
  "num_attention_heads": 64,
  "num_key_value_heads": 8,
